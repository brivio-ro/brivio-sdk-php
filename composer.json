{
    "name": "brivio-ro/sdk",
    "description": "Official Brivio PHP SDK — invoicing, contacts, articles, locations and module entitlements, plus drop-in compatibility shims for migrating from FGO, SmartBill and Oblio.",
    "type": "library",
    "license": "MIT",
    "keywords": ["brivio", "e-factura", "invoicing", "romania", "anaf", "smartbill", "fgo", "oblio"],
    "homepage": "https://brivio.ro",
    "support": {
        "issues": "https://github.com/dragoscv/brivio/issues",
        "docs": "https://brivio.ro/developers/docs"
    },
    "authors": [
        { "name": "Brivio", "homepage": "https://brivio.ro" }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Brivio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Brivio\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
